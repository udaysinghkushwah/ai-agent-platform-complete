# Enterprise Production Environment Configuration
NODE_ENV=production

# Database Settings (PostgreSQL 16)
DATABASE_URL="postgresql://aap:aap_production_password@localhost:5432/aap_prod?schema=public&sslmode=prefer"

# Redis Cache & Task Queue (Redis 7)
REDIS_URL="redis://localhost:6379"

# Security & Credentials
JWT_SECRET="super-secret-production-jwt-token-key-32chars"
CORS_ORIGIN="http://localhost:3001"

# Service Ports
PORT=3000
DASHBOARD_PORT=3001
DEMO_AGENT_PORT=4000

# Public API Endpoint for Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3000"
