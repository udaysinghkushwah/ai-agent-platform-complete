DATABASE_URL="postgresql://aap:aap_local_dev@localhost:5432/aap_dev?schema=public"
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=10

# Evaluation (MVP-3)
EVAL_WORKER_CONCURRENCY=4

# LLM-as-judge provider (OpenAI-compatible /chat/completions). Any evaluator
# run using type "LLM_JUDGE" will report degraded results, not crash, if
# this is left unset.
LLM_JUDGE_BASE_URL="https://api.openai.com/v1"
LLM_JUDGE_MODEL="gpt-4o-mini"
LLM_JUDGE_API_KEY=""
LLM_JUDGE_TIMEOUT_MS=20000

# Alerts (MVP-5)
ALERT_CHECK_INTERVAL_MS=60000
RETENTION_CHECK_INTERVAL_MS=86400000

# Alert email delivery — degrades to "notification skipped, logged as
# notifyError" if unset, never crashes the checker.
ALERT_EMAIL_PROVIDER="resend"
ALERT_EMAIL_API_KEY=""
ALERT_EMAIL_FROM="alerts@ai-agent-platform.local"
